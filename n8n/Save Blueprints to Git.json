{
  "name": "Save Blueprints to Git",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Clone workflow payload safely\nlet workflowStr = JSON.stringify($json);\n\n// 1. Sanitize Secrets, Internal Webhook URLs, and Dynamic UUIDs\nconst idReplacements = [\n  [/https:\\/\\/automation\\.yourdomain\\.com/g, \"https://{{N8N_HOST}}\"],\n  [/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/g, \"{{UUID_PLACEHOLDER}}\"]\n];\n\nidReplacements.forEach(([pattern, placeholder]) => {\n  workflowStr = workflowStr.replace(pattern, placeholder);\n});\n\nconst workflow = JSON.parse(workflowStr);\n\n// Clean Credentials, Webhook IDs, and Node Metadata\nif (workflow.nodes && Array.isArray(workflow.nodes)) {\n  workflow.nodes.forEach(node => {\n    if (node.credentials) {\n      Object.keys(node.credentials).forEach(credType => {\n        node.credentials[credType] = { id: \"\", name: \"\" };\n      });\n    }\n    if (node.type === 'n8n-nodes-base.webhook' && node.webhookId) {\n      node.webhookId = \"\";\n    }\n  });\n}\n\ndelete workflow.id;\ndelete workflow.pinData;\ndelete workflow.active;\ndelete workflow.versionId;\n\n// 2. Safely Parse Tags Array\nconst tags = Array.isArray(workflow.tags) ? workflow.tags.map(t => (typeof t === 'string' ? t : t.name || '')) : [];\n\n// Extract Package Tag Value (e.g. 'pkg:RFF' -> 'rff')\nconst pkgTag = tags.find(t => t.toLowerCase().startsWith('pkg:'));\nconst pkg = pkgTag ? pkgTag.replace(/^pkg:/i, '').trim().toLowerCase() : 'uncategorized-product';\n\n// Extract Category Tag Value (e.g. 'category:signals' -> 'signals')\nconst categoryTag = tags.find(t => t.toLowerCase().startsWith('category:'));\nconst category = categoryTag ? categoryTag.replace(/^category:/i, '').trim().toLowerCase() : 'general';\n\n// Standardize workflow filename from workflow name\nconst workflowName = workflow.name || 'untitled-workflow';\nconst safeFileName = workflowName\n  .toLowerCase()\n  .replace(/[^a-z0-9]/g, '-')\n  .replace(/-+/g, '-')\n  .replace(/^-|-$/g, '');\n\n// Construct Repository Target Path: {pkg}/blueprints/{category}/{filename}.json\nconst targetFilePath = `blueprints/${category}/${safeFileName}.json`;\n\n// Format final JSON string and Base64 encode for Forgejo API\nconst cleanJson = JSON.stringify(workflow, null, 2);\nconst base64Content = Buffer.from(cleanJson).toString('base64');\n\nreturn [{\n  json: {\n    workflowName: workflowName,\n    filePath: targetFilePath,\n    base64Content: base64Content,\n    commitMessage: `chore(blueprint): sync ${workflowName} [${pkg}/${category}]`\n  }\n}];"
      },
